# Gmail que ENVÍA los correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo_emisor@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_aqui

# Nombre que verá el usuario como remitente
SMTP_FROM_NAME=DocuVerify

# URL del frontend
FRONTEND_URL=http://localhost:5173

# URL del servidor backend
BACKEND_URL=http://127.0.0.1:8000

VITE_API_URL=http://127.0.0.1:8000

# API Key de Google Gemini
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Contraseña de base de datos PostgreSQL (Ejemplo)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/docuverify_db

# Clave para los tokens de acceso JWT (Ejemplo)
JWT_SECRET_KEY=tu_clave_secreta_jwt_aqui